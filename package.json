{
  "name": "reportportal",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "HEADLESS=false playwright test --project=chromium",
    "test:headless": "HEADLESS=true playwright test --project=chromium",
    "test:local": "TEST_ENV=local playwright test --project=chromium",
    "test:web": "TEST_ENV=web playwright test --project=chromium",
    "test:local:headed": "TEST_ENV=local HEADLESS=false playwright test --project=chromium",
    "test:web:headed": "TEST_ENV=web HEADLESS=false playwright test --project=chromium",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:mocha:local": "TEST_ENV=local mocha --timeout 30000 --require ts-node/register \"src/tests/mocha/*.spec.ts\"",
    "test:mocha:web": "TEST_ENV=web mocha --timeout 30000 --require ts-node/register \"src/tests/mocha/*.spec.ts\"",
    "test:mocha:parallel": "TEST_ENV=web mocha --timeout 30000 --parallel --jobs 4 --require ts-node/register \"src/tests/mocha/*.spec.ts\"",
    "test:bdd:web": "TEST_ENV=web cucumber-js",
    "test:bdd:web:only": "TEST_ENV=web cucumber-js --tags @only",
    "test:bdd:parallel": "TEST_ENV=web cucumber-js --parallel 4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vardeniSergoyan/ReportPortal.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/vardeniSergoyan/ReportPortal/issues"
  },
  "homepage": "https://github.com/vardeniSergoyan/ReportPortal#readme",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "@playwright/test": "^1.61.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@reportportal/agent-js-playwright": "^5.4.1",
    "dotenv": "^17.4.2",
    "winston": "^3.19.0"
  }
}
